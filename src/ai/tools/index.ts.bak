'use server';
/**
 * @fileOverview Central registration point for all AI tools
 * This file breaks circular dependencies by importing the AI instance and tool definitions separately
 * 
 * All tools should be registered here and exported from this central location to maintain consistency
 * and avoid circular dependencies.
 */

import { ai, z } from '@/ai/genkit';

// Import tool definitions and implementations
import { 
  retrieveLoreInfoToolDefinition, 
  retrieveLoreInfoImplementation 
} from './retrieve-lore-info';

import {
  retrieveContextSchema,
  updateContextSchema
} from './context-manager-schemas';

import {
  retrieveContext,
  updateContext
} from './context-manager';

import {
  generateBranchesSchema,
  selectBranchSchema
} from './narrative-branching-schemas';

import {
  generateBranches,
  selectBranch
} from './narrative-branching';

import {
  generateLocationSchema,
  retrieveLocationSchema,
  generateEnvironmentSchema
} from './world-building-schemas';

import {
  generateLocation,
  retrieveLocation,
  generateEnvironment
} from './world-building';

import {
  updateRelationship,
  addCharacterMemory,
  retrieveCharacterMemories
} from './relationship-manager';

import {
  addLocationToLorebook,
  enrichLorebook
} from '@/ai/lore-tools';

// Register all tools
export const retrieveLoreInfoTool = ai.defineTool(
  retrieveLoreInfoToolDefinition,
  retrieveLoreInfoImplementation
);

// Context management tools
export const retrieveContextTool = ai.defineTool(
  {
    name: "retrieveContext",
    description: "Retrieve story context to maintain narrative consistency",
    inputSchema: retrieveContextSchema,
    outputSchema: z.any(),
  },
  retrieveContext
);

export const updateContextTool = ai.defineTool(
  {
    name: "updateContext",
    description: "Update story context with new events, relationships, or world state changes",
    inputSchema: updateContextSchema,
    outputSchema: z.object({
      success: z.boolean(),
      message: z.string()
    }),
  },
  updateContext
);

// Narrative branching tools
export const generateBranchesTool = ai.defineTool(
  {
    name: "generateNarrativeBranches",
    description: "Generate potential story branches based on player options",
    inputSchema: generateBranchesSchema,
    outputSchema: ai.z.object({
      branches: ai.z.array(ai.z.object({
        id: ai.z.string(),
        playerAction: ai.z.string(),
        consequence: ai.z.string(),
        narrativeHook: ai.z.string(),
        probability: ai.z.number(),
        created: ai.z.number()
      }))
    }),
  },
  generateBranches
);

export const selectBranchTool = ai.defineTool(
  {
    name: "selectNarrativeBranch",
    description: "Select the most appropriate narrative branch based on the player's action",
    inputSchema: selectBranchSchema,
    outputSchema: ai.z.object({
      selectedBranch: ai.z.object({
        id: ai.z.string(),
        playerAction: ai.z.string(),
        consequence: ai.z.string(),
        narrativeHook: ai.z.string(),
        probability: ai.z.number(),
        created: ai.z.number()
      }).nullable(),
      fallbackResponse: ai.z.string().optional(),
      needsNewBranches: ai.z.boolean()
    }),
  },
  selectBranch
);

// World building tools
export const generateLocationTool = ai.defineTool(
  {
    name: "generateLocation",
    description: "Generate detailed information about a location in the story",
    inputSchema: generateLocationSchema,
    outputSchema: ai.z.object({
      location: ai.z.object({
        name: ai.z.string(),
        description: ai.z.string(),
        atmosphere: ai.z.string(),
        notableFeatures: ai.z.array(ai.z.string()),
        hiddenElements: ai.z.array(ai.z.string()),
        connectedLocations: ai.z.array(ai.z.string())
      }),
      isNew: ai.z.boolean()
    }),
  },
  generateLocation
);

export const generateEnvironmentTool = ai.defineTool(
  {
    name: "generateEnvironment",
    description: "Generate environmental elements like weather, time of day, and sensory details",
    inputSchema: generateEnvironmentSchema,
    outputSchema: ai.z.object({
      environmentalElements: ai.z.array(ai.z.object({
        type: ai.z.enum(['weather', 'timeOfDay', 'atmosphere', 'sound', 'smell']),
        description: ai.z.string(),
        impact: ai.z.string()
      })),
      timeHasProgressed: ai.z.boolean()
    }),
  },
  generateEnvironment
);

export const retrieveLocationTool = ai.defineTool(
  {
    name: "retrieveLocation",
    description: "Retrieve previously generated details about a location",
    inputSchema: retrieveLocationSchema,
    outputSchema: ai.z.object({
      exists: ai.z.boolean(),
      location: ai.z.object({
        name: ai.z.string(),
        description: ai.z.string(),
        atmosphere: ai.z.string(),
        notableFeatures: ai.z.array(ai.z.string()),
        hiddenElements: ai.z.array(ai.z.string()),
        connectedLocations: ai.z.array(ai.z.string())
      }).optional(),
      message: ai.z.string().optional()
    }),
  },
  retrieveLocation
);

// Relationship management tools
export const updateRelationshipTool = ai.defineTool(
  {
    name: "updateRelationship",
    description: "Update the relationship between two characters",
    inputSchema: z.object({
      character1: z.string().describe("ID or name of the first character"),
      character2: z.string().describe("ID or name of the second character"),
      relationshipType: z.string().describe("Type of relationship (ally, enemy, family, friend, etc.)"),
      relationshipIntensity: z.number().min(1).max(10).describe("Intensity of the relationship (1-10)"),
      event: z.string().describe("Description of the event that affected this relationship"),
      impact: z.number().min(-5).max(5).describe("How this event affected the relationship (-5 to +5)")
    }),
    outputSchema: z.object({
      success: z.boolean(),
      message: z.string()
    }),
  },
  updateRelationship
);

export const addCharacterMemoryTool = ai.defineTool(
  {
    name: "addCharacterMemory",
    description: "Add a memory to a character's history",
    inputSchema: z.object({
      characterId: z.string().describe("ID or name of the character"),
      memory: z.string().describe("Description of the memory to add"),
      importance: z.number().min(1).max(10).describe("Importance of this memory (1-10)")
    }),
    outputSchema: z.object({
      success: z.boolean(),
      message: z.string()
    }),
  },
  addCharacterMemory
);

export const retrieveCharacterMemoriesTool = ai.defineTool(
  {
    name: "retrieveCharacterMemories",
    description: "Retrieve memories for a specific character",
    inputSchema: z.object({
      characterId: z.string().describe("ID or name of the character"),
      limit: z.number().optional().describe("Maximum number of memories to retrieve")
    }),
    outputSchema: z.object({
      memories: z.array(z.object({
        content: z.string(),
        timestamp: z.number(),
        importance: z.number()
      })),
      characterInfo: z.object({
        name: z.string(),
        description: z.string().optional()
      }).optional()
    }),
  },
  retrieveCharacterMemories
);

// Lorebook tools
export const addLocationToLorebookTool = ai.defineTool(
  {
    name: "addLocationToLorebook",
    description: "Add a new location to the lorebook",
    inputSchema: z.object({
      locationName: z.string().describe("Name of the location to add"),
      description: z.string().describe("Detailed description of the location"),
      category: z.string().optional().describe("Category for this location (e.g., 'Cities', 'Landmarks')")
    }),
    outputSchema: z.object({
      success: z.boolean(),
      message: z.string()
    }),
  },
  addLocationToLorebook
);

export const enrichLorebookTool = ai.defineTool(
  {
    name: "enrichLorebook",
    description: "Automatically extract and add information to the lorebook from narrative text",
    inputSchema: z.object({
      narrativeText: z.string().describe("The narrative text to analyze for lore elements"),
      extractionFocus: z.array(z.enum(['characters', 'locations', 'items', 'events', 'concepts'])).optional()
        .describe("What types of lore elements to focus on extracting")
    }),
    outputSchema: z.object({
      extractedElements: z.number(),
      addedToLorebook: z.number(),
      message: z.string()
    }),
  },
  enrichLorebook
);

// Export all tools from a single location
export const tools = {
  // Lore tools
  retrieveLoreInfoTool,
  addLocationToLorebookTool,
  enrichLorebookTool,
  
  // Context management
  retrieveContextTool,
  updateContextTool,
  
  // Narrative branching
  generateBranchesTool,
  selectBranchTool,
  
  // World building
  generateLocationTool,
  generateEnvironmentTool,
  retrieveLocationTool,
  
  // Relationship management
  updateRelationshipTool,
  addCharacterMemoryTool,
  retrieveCharacterMemoriesTool
};
